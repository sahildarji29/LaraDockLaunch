FROM php:8.3-fpm-alpine

# High-Scale Laravel Master Image with Node.js Support
# Optimized for 300-400 containers on single instance
# This image contains Laravel 12 + Node.js + all dependencies for instant project deployment

# Install system dependencies with minimal packages
RUN apk add --no-cache --update \
    libzip-dev \
    unzip \
    curl \
    git \
    bash \
    supervisor \
    && docker-php-ext-configure zip \
    && docker-php-ext-install zip pdo pdo_mysql \
    && rm -rf /var/cache/apk/*

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install NVM and latest Node.js with minimal footprint
ENV NODE_VERSION="20.10.0"

RUN apk add --no-cache nodejs npm su-exec shadow && \
    npm cache clean --force

# Install Laravel globally for faster project creation (Laravel 12)
RUN composer global require laravel/installer --optimize-autoloader

# Add Composer global bin to PATH
ENV PATH="$PATH:/root/.composer/vendor/bin"

# PHP Configuration optimizations for high-scale deployment
RUN { \
    echo 'memory_limit = 256M'; \
    echo 'max_execution_time = 300'; \
    echo 'max_input_time = 300'; \
    echo 'post_max_size = 100M'; \
    echo 'upload_max_filesize = 100M'; \
    echo 'max_file_uploads = 20'; \
    echo 'opcache.enable = 1'; \
    echo 'opcache.enable_cli = 1'; \
    echo 'opcache.memory_consumption = 128'; \
    echo 'opcache.interned_strings_buffer = 8'; \
    echo 'opcache.max_accelerated_files = 10000'; \
    echo 'opcache.revalidate_freq = 2'; \
    echo 'opcache.fast_shutdown = 1'; \
    echo 'realpath_cache_size = 4096K'; \
    echo 'realpath_cache_ttl = 600'; \
    } > /usr/local/etc/php/conf.d/docker-php-optimizations.ini

# Configure PHP-FPM for high-scale deployment
RUN { \
    echo '[global]'; \
    echo 'error_log = /dev/null'; \
    echo 'daemonize = no'; \
    echo ''; \
    echo '[www]'; \
    echo 'user = laraveluser'; \
    echo 'group = laraveluser'; \
    echo 'listen = 9000'; \
    echo 'listen.owner = laraveluser'; \
    echo 'listen.group = laraveluser'; \
    echo 'listen.mode = 0660'; \
    echo 'pm = dynamic'; \
    echo 'pm.max_children = 10'; \
    echo 'pm.start_servers = 2'; \
    echo 'pm.min_spare_servers = 1'; \
    echo 'pm.max_spare_servers = 3'; \
    echo 'pm.max_requests = 500'; \
    echo 'clear_env = no'; \
    echo 'catch_workers_output = yes'; \
    echo 'decorate_workers_output = no'; \
    echo 'access.log = /dev/null'; \
    echo 'slowlog = /dev/null'; \
    echo 'php_admin_value[error_log] = /dev/null'; \
    echo 'php_admin_flag[log_errors] = off'; \
} > /usr/local/etc/php-fpm.conf

# Create a dynamic initialization script optimized for high-scale
COPY laravel-init.sh /usr/local/bin/laravel-init.sh
RUN chmod +x /usr/local/bin/laravel-init.sh

# Create healthcheck script
RUN printf '#!/bin/bash\n\
if ! pgrep -f "php-fpm: master process" > /dev/null; then\n\
    exit 1\n\
fi\n\
\n\
if ! php -v > /dev/null 2>&1; then\n\
    exit 1\n\
fi\n\
\n\
if [ -f "/var/www/artisan" ]; then\n\
    if ! php /var/www/artisan --version > /dev/null 2>&1; then\n\
        exit 1\n\
    fi\n\
fi\n\
\n\
exit 0' > /usr/local/bin/healthcheck.sh && chmod +x /usr/local/bin/healthcheck.sh

WORKDIR /var/www

# Health check for high-scale deployment
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh

# Resource limits and optimizations
ENV PHP_MEMORY_LIMIT=256M
ENV PHP_MAX_EXECUTION_TIME=300
ENV FPM_MAX_CHILDREN=10
ENV FPM_MAX_REQUESTS=500

# Set the entrypoint to our initialization script
ENTRYPOINT ["/usr/local/bin/laravel-init.sh"]